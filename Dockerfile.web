FROM python:3.11.7-slim

LABEL maintainer="Code Quality Inspector"
LABEL description="FastAPI Web Server for Code Quality Inspector"

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 업데이트 및 필수 도구 설치
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    build-essential \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Claude CLI 설치 스크립트 복사 및 실행
# 주의: 실제 Claude CLI 설치 방법에 따라 수정 필요
COPY scripts/install_claude.sh /tmp/install_claude.sh
RUN chmod +x /tmp/install_claude.sh && \
    /tmp/install_claude.sh || echo "Claude CLI installation skipped (script failed)"

# 애플리케이션 코드 복사
COPY app /app/app
COPY rules /app/rules

# 로그 디렉토리 생성
RUN mkdir -p /app/logs /tmp/code-inspection

# 포트 노출
EXPOSE 8000

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 환경 변수 설정
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 실행 명령
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
