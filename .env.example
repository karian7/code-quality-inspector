# Application Settings
APP_NAME=Code Quality Inspector
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# Celery Settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIMEOUT=900
CELERY_MAX_RETRIES=3
CELERY_WORKER_CONCURRENCY=5

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Git Settings
GIT_CLONE_TIMEOUT=300
GIT_CLONE_DEPTH=1

# Claude CLI Settings
CLAUDE_CLI_PATH=claude
CLAUDE_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT=600

# Anthropic API Key (used by Claude CLI)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Codex CLI Settings
CODEX_CLI_PATH=codex
CODEX_API_KEY=your-openai-api-key-here
CODEX_MODEL=gpt-4
CODEX_MAX_TOKENS=4096
CODEX_TIMEOUT=600

# OpenAI API Key (used by Codex CLI)
OPENAI_API_KEY=your-openai-api-key-here

# AI Provider Settings
DEFAULT_AI_PROVIDER=codex

# Directory Settings
WORK_DIR=/tmp/code-inspection
RULES_DIR=/app/rules
LOG_DIR=/app/logs

# Security Settings
API_KEY_HEADER=X-API-Key
API_KEYS=["your-api-key-1","your-api-key-2"]

# Callback Settings
CALLBACK_CONNECT_TIMEOUT=10  # TLS connection timeout (seconds)
CALLBACK_READ_TIMEOUT=30     # Response read timeout (seconds)
CALLBACK_WRITE_TIMEOUT=10    # Request write timeout (seconds)
CALLBACK_POOL_TIMEOUT=10     # Connection pool timeout (seconds)
CALLBACK_MAX_RETRIES=3

# Logging Settings
LOG_FILE=inspector.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days